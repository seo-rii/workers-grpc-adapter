{
  "name": "workers-grpc-adapter",
  "version": "0.0.0-prototype.1",
  "description": "Experimental grpc-js client transport over binary gRPC-Web for Workers; not a certified replacement",
  "private": true,
  "packageManager": "npm@11.4.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seo-rii/workers-grpc-adapter.git"
  },
  "homepage": "https://github.com/seo-rii/workers-grpc-adapter#readme",
  "bugs": { "url": "https://github.com/seo-rii/workers-grpc-adapter/issues" },
  "keywords": ["grpc", "grpc-web", "cloudflare-workers", "google-cloud", "typescript"],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.mjs", "require": "./dist/index.js" },
    "./config": { "types": "./dist/config.d.ts", "import": "./dist/config.mjs", "require": "./dist/config.js" },
    "./adapter": { "types": "./dist/adapter.d.ts", "import": "./dist/adapter.mjs", "require": "./dist/adapter.js" },
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.mjs", "require": "./dist/server.js" },
    "./build": { "types": "./dist/build/index.d.cts", "import": "./dist/build/index.cjs", "require": "./dist/build/index.cjs" },
    "./build/src/client": { "types": "./dist/client.d.ts", "import": "./dist/client.mjs", "require": "./dist/client.js" },
    "./build/src/client.js": { "types": "./dist/client.d.ts", "import": "./dist/client.mjs", "require": "./dist/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "vendor", "README.md", "LICENSE", "NOTICE", "docs/api.md", "docs/limitations.md", "docs/resources.md"],
  "engines": {"node": ">=22"},
  "scripts": {
    "test:firestore-watch-errors": "node scripts/test-firestore-watch-errors.cjs",
    "test:modern-firestore-recovery": "node scripts/test-modern-firestore-recovery.cjs",
    "test:datastore-lookup": "node scripts/test-datastore-lookup.cjs",
    "test:firestore-recovery": "node scripts/test-firestore-recovery.cjs",
    "test:parent-calls": "node scripts/test-parent-calls.cjs",
    "test:modern-firestore-watch": "node scripts/test-modern-firestore-watch.cjs",
    "build": "node scripts/build.cjs",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:local": "node --test test/*.test.cjs",
    "test:fuzz": "npm run build && node scripts/fuzz.cjs",
    "test:fuzz:ci": "node scripts/fuzz-campaign.cjs --profile=ci",
    "test:fuzz:extended": "node scripts/fuzz-campaign.cjs --profile=extended",
    "test:workerd:integration": "node scripts/test-workerd-integration.cjs",
    "test:workerd:lifecycle": "node scripts/test-workerd-lifecycle.cjs",
    "test:workerd:fuzz": "node scripts/test-workerd-fuzz.cjs",
    "test:pack": "node scripts/test-pack.cjs",
    "test:types": "node scripts/test-types.cjs",
    "test:google": "node scripts/google-test.cjs",
    "test:request-streaming": "node scripts/test-request-streaming.cjs",
    "test:workers": "node scripts/workers-test.cjs",
    "test:workers:sdk": "node scripts/workers-sdk-test.cjs",
    "test:workers:shared": "node scripts/workers-shared-test.cjs",
    "test:evidence": "node scripts/test-evidence.cjs --check",
    "emulators:install": "node fixtures/emulators/download.cjs",
    "test:emulators": "node scripts/google-emulator-test.cjs",
    "test:emulators:lifecycle": "node fixtures/emulators/lifecycle.cjs",
    "test:sdk:types": "node scripts/test-sdk-types.cjs",
    "test:sdk:local": "node scripts/google-local-test.cjs",
    "test:auth": "node scripts/test-google-auth.cjs",
    "test:differential": "node test/native-differential.cjs",
    "test:envoy": "node scripts/envoy-test.cjs",
    "test:contract": "node scripts/test-contract.cjs",
    "test:benchmark": "node scripts/benchmark.cjs",
    "fixtures:install": "node scripts/install-fixtures.cjs",
    "verify": "node scripts/verify.cjs",
    "doctor": "node scripts/doctor.cjs",
    "prepack": "npm run build"
  },
  "devDependencies": { "typescript": "5.8.3", "@types/node": "22.15.30", "fast-check": "4.10.2" },
  "peerDependencies": { "esbuild": ">=0.25.0 <1", "typescript": ">=5.8.0 <6" },
  "peerDependenciesMeta": { "esbuild": { "optional": true }, "typescript": { "optional": true } }
}
