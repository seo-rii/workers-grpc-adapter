  "patchPolicy": {
    "P-01": "Workers Channel construction; reject foreign overrides; explicit unsupported waitForReady",
    "P-02": "Bridge final method/options; preserve omitted deadline; use transformed argument",
    "P-03": "Factory imports the same vendored Client",
    "P-04": "HTTPS credentials implemented by src/credentials.ts, not copied from native TLS source",
    "P-05": "Client-only root exports and module closure",
    "P-06": "Type-only http2/tls imports; use structural ParentCall deadline/cancellation subset instead of native server types; use node: builtins"
  },
