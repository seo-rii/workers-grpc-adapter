# No real credentials in this file. Do not commit .env or .dev.vars.
WGA_RUN_GOOGLE_TESTS=0
WGA_ALLOW_TEST_WRITES=0
WGA_GOOGLE_SUITES=datastore-crud,firestore-crud
WGA_DATASTORE_PROJECT=
WGA_FIRESTORE_PROJECT=
WGA_SECRET_MANAGER_PROJECT=
WGA_DATASTORE_DATABASE=
WGA_FIRESTORE_DATABASE=
WGA_GOOGLE_CREDENTIALS_JSON=
WGA_SECRET_NAME=
# Node requires your own trusted gRPC-Web gateway; no public gateway is provided.
WGA_TRANSPORT_MODE=grpc-web
WGA_ENDPOINTS_JSON={}
# Worker only; use a random secret with >=32 characters. Request bodies cannot override it.
WGA_TEST_KEY=
